{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mpv-basic-player",
  "version": "0.1.0",
  "identifier": "dev.tauri-plugin-mpv.example",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tauri-plugin-mpv \u2014 basic player",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}